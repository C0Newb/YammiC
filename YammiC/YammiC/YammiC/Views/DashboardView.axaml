<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:YammiC.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="900"
             Header="YammiC"
             x:DataType="vm:DashboardViewModel"
             x:Class="YammiC.Views.DashboardView">
    <Design.DataContext>
        <vm:DashboardViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="20">

            <Border Classes="card" IsVisible="{Binding NeedsNotificationAccess}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Notification access needed" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="Lets the bike show what is playing and control the music." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Grant" Command="{Binding GrantNotificationAccessCommand}" />
                </Grid>
            </Border>

            <!-- Connection -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="title" FontSize="20" TextTrimming="CharacterEllipsis" Text="{Binding BikeName}" />
                            <TextBlock Classes="caption" Text="{Binding StatusText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Foreground="{DynamicResource SystemErrorTextColor}" TextWrapping="Wrap"
                               IsVisible="{Binding HasError}" Text="{Binding LastError}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Connect" IsEnabled="{Binding CanConnect}" Command="{Binding ConnectCommand}" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Disconnect" IsEnabled="{Binding CanDisconnect}" Command="{Binding DisconnectCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live data -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="LIVE" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Border Classes="card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="Gear" />
                            <TextBlock Classes="value" Text="{Binding GearText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="Engine speed" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="value" Text="{Binding RpmText}" />
                                <TextBlock Classes="caption" VerticalAlignment="Bottom" Margin="0,0,0,5" Text="rpm" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="Coolant" />
                            <TextBlock Classes="value" Text="{Binding WaterTempText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Classes="card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="Intake air" />
                            <TextBlock Classes="value" Text="{Binding IntakeTempText}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Classes="caption" TextWrapping="Wrap" Margin="4,0,0,0"
                           IsVisible="{Binding LiveHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding LiveHint}" />
            </StackPanel>

            <!-- Track timer -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="TRACK TIMER" />
                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{Binding TimerBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="subtitle" Text="{Binding TimerStateText}" />
                            <TextBlock Text="{Binding TimerTrackText}" />
                            <TextBlock Classes="caption" IsVisible="{Binding TimerBestText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Text="{Binding TimerBestText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Bike displays -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="BIKE DISPLAY" />
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Virtual Pit Board" />
                                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding VpbStatus}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding VpbEnabled}" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Navigation" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding NavigationStatus}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Media -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="NOW PLAYING" />
                <Border Classes="card">
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="18" TextTrimming="CharacterEllipsis" Text="{Binding MediaTrack}" />
                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding MediaArtist}" />
                        <TextBlock Classes="caption" Text="{Binding MediaState}" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentPage>
