<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:YammiC.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             Header="Debug log"
             x:DataType="vm:DebugLogViewModel"
             x:Class="YammiC.Views.DebugLogView">
    <Design.DataContext>
        <vm:DebugLogViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Copy all" Click="Copy_Click" />
            <Button Content="Clear logs" Command="{Binding ClearCommand}" />
        </StackPanel>
        <!-- A recycling list: only the lines on screen are drawn, however long the log is. -->
        <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Lines}" SelectionMode="Multiple">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</ContentPage>
